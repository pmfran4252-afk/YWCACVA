# ---------------------------------------------------------------------------
# Sanity
# ---------------------------------------------------------------------------
# Leave these blank and the site renders from the typed content seed in
# src/content/seed.ts. Fill them in and every query switches to live CMS
# content — no code changes required.
#
# Create a project with:  npx sanity@latest init --env
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---------------------------------------------------------------------------
# QA / visual regression
# ---------------------------------------------------------------------------
# GSAP ScrollSmoother transforms the whole page, which defeats native
# scrolling and full-page screenshots. Set to 1 for e2e and screenshot runs.
NEXT_PUBLIC_DISABLE_SMOOTH_SCROLL=

# ---------------------------------------------------------------------------
# Shop (Stripe)
# ---------------------------------------------------------------------------
# Without this the shop still renders and the cart works; checkout returns a
# clear "not connected yet" message instead of failing silently.
# Stripe hosts the payment page, so no card details ever reach this site.
STRIPE_SECRET_KEY=

# Used to build Stripe's success/cancel URLs when the request has no origin
# header (for example a server-side call). Set to the production URL.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Donations (Givebutter)
# ---------------------------------------------------------------------------
# Account ID from the Givebutter dashboard. Defaults to the YWCA account in
# code; set here only to point a staging build at a different account.
NEXT_PUBLIC_GIVEBUTTER_ACCOUNT=
